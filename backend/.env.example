# --- Servidor ---
NODE_ENV=development
PORT=3000
# URL pública del backend/landing; se usa para el contenido del QR fijo de cada unidad
PUBLIC_BASE_URL=https://abordo.example.mx
CORS_ORIGIN=*

# --- Seguridad (OBLIGATORIOS en producción) ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-32+-caracteres
JWT_EXPIRES_IN=7d
# 32 bytes en hex (64 caracteres). Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Base de datos (PostgreSQL) ---
# Local:  postgres://postgres:postgres@localhost:5432/abordo
# Neon:   copia la cadena "Pooled connection" del panel (host con -pooler), ya trae ?sslmode=require
# Render: usa la "Internal Database URL" si el backend también está en Render (misma región);
#         la "External" solo para conectarte desde tu PC.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/abordo
# auto = TLS salvo localhost / URL interna de Render (o lo que diga ?sslmode= en la URL)
# Valores: auto | true | no-verify (TLS sin verificar certificado) | false
DATABASE_SSL=auto
DATABASE_POOL_MAX=10

# --- API de pey ---
# mock = simula los cobros (demo/desarrollo). live = usa el API real de pey.
PEY_MODE=mock
PEY_API_BASE_URL=https://api.pey.example
PEY_WEBHOOK_SECRET=
# Solo modo mock: segundos que tarda en "pagarse" un cobro simulado
PEY_MOCK_PAY_DELAY_SECONDS=6

# --- Negocio ---
CHARGE_TTL_SECONDS=300
DEFAULT_FARE_CENTS=1200
